    {
      "id": "mem-update-history",
      "category": "memory",
      "description": "Salary raise is recorded as history, previous value recallable",
      "turns": [
        {
          "user": "My salary is 75k per month",
          "expect": {
            "intent": "memory_update",
            "profile": {
              "income": 75000.0
            },
            "planner_called": false
          }
        },
        {
          "user": "I got a raise, my salary is now 82k",
          "expect": {
            "profile": {
              "income": 82000.0
            },
            "previous": {
              "income": 75000.0
            }
          }
        },
        {
          "user": "What was my previous salary?",
          "expect": {
            "intent": "memory_recall",
            "planner_called": false,
            "system_contains": [
              "Previous: ₹75,000"
            ]
          }
        }
      ]
    },
    {
      "id": "mem-correction",
