          "user": "Actually it's 65k, not 60k",
          "expect": {
            "profile": {
              "income": 65000.0
            },
            "previous": {
              "income": null
            },
            "retracted": {
              "income": [
                60000.0
              ]
            },
            "system_contains": [
              "Corrected Mistakes"
            ]
          }
        }
      ]
    },
