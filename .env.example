# LLM (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
TORA_LLM_NUM_CTX=8192
TORA_MODEL_CACHE_SECONDS=60

# Web search: duckduckgo (default, no key) or tavily
SEARCH_PROVIDER=duckduckgo
# TAVILY_API_KEY=

# API server
TORA_HOST=127.0.0.1
TORA_PORT=8000
TORA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TORA_RATE_LIMIT_PER_MINUTE=30
TORA_MAX_MESSAGE_CHARS=8000
TORA_MAX_HISTORY_ITEMS=200
TORA_TOOL_TIMEOUT_SECONDS=30

# Server-side conversations
TORA_SESSION_DB=backend/.data/tora_sessions.db
TORA_SESSION_TTL_DAYS=30
